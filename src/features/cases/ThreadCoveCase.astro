---
import TypeLine from '../../components/TypeLine.astro';
import type { CoreProject } from '../../data/projects';
import CaseEvidence from '../../components/CaseEvidence.astro';
import ProjectWorkflow from '../../components/ProjectWorkflow.astro';
import CaseClosing from '../../components/CaseClosing.astro';
import './cases.css';
import { coveStages } from '../../data/studio-art';
interface Props { project: CoreProject }
const { project } = Astro.props;
const sheets = coveStages;
---
<article class="studio-case thread-case container" id="overview">
  <nav class="case-chapters" aria-label="案例章节"><span>02 / THREADCOVE</span><a href="#interface">真实界面</a><a href="#mechanism">研究过程</a><a href="#tradeoffs">工程取舍</a></nav>
  <header class="research-masthead">
    <div><p class="eyebrow">FIELDNOTES / 线索的编织</p><h1>{project.name}</h1><p class="case-lead"><TypeLine text={project.summary}/></p></div>
    <p class="research-abstract">{project.description}<br /><a class="text-link" href="#interface">走进工作台 ↓</a></p>
  </header>
  <section class="research-desk" aria-label="研究过程的纸页概念示意" data-research-desk data-selection="0">
    <div class="desk-registration"><span>FIELDNOTES — STUDY 02</span><span>概念示意 / 非产品截图</span></div>
    <div class="paper-installation" data-paper-cloth data-cloth-state="idle">
      <canvas aria-hidden="true"></canvas>

      <p>轻点选择 · 按住拖动 · 方向键切换</p>
    <div class="desk-sheets" role="tablist" aria-label="选择一个研究阶段">
      {sheets.map((s,i) => <button type="button" class="desk-sheet" role="tab" id={`desk-tab-${i}`} aria-controls={`desk-panel-${i}`} aria-selected={i === 0} tabindex={i === 0 ? 0 : -1} style={`--sheet-order:${i};--stage-color:${s.color}`}><span class="sheet-pin-rivet" aria-hidden="true"></span><span class="eyebrow">{`${i+1} / FIELDNOTES`}</span><strong>{s.label}</strong><span class="sheet-rule"></span><span class="sheet-thought">{s.text}</span><span class="sheet-mark" aria-hidden="true">{s.en}</span></button>)}
    </div>
    </div>
    {sheets.map((s,i) => <div class="desk-caption" role="tabpanel" id={`desk-panel-${i}`} aria-labelledby={`desk-tab-${i}`}><span>0{i+1}</span><p>{s.text} 这是对工作方式的概念表达；实际能力以界面和源码为准。</p></div>)}
  </section>
  <CaseEvidence project={project}/>
  <section class="case-section research-sequence" id="mechanism">
    <div class="case-section-heading"><div><p class="eyebrow">02 / A RESEARCH THREAD</p><h2>让一次提问，<br />成为持续的研究。</h2></div><p>由使用者提出问题与核验结论。<br />工作台负责组织任务、事件和材料。</p></div>
    <ProjectWorkflow steps={project.workflow}/>
    {project.mechanisms.map(m => <article><div><span class="step-number">{m.step}</span><span class="eyebrow">{m.tag}</span></div><h3>{m.title}</h3><p>{m.desc}</p></article>)}
  </section>
  <section class="case-section" id="tradeoffs"><p class="eyebrow">03 / MARGINAL NOTES</p><h2>工具背后的三个选择。</h2><div class="engineering-notes">{project.tradeoffs.map((t,i) => <article><span class="step-number">0{i+1}</span><div><h3>{t.title}</h3><p>{t.summary}</p><p class="note-detail">{t.detail}</p><a class="text-link" href={t.sourceUrl} target="_blank" rel="noopener noreferrer">{t.sourceRef} ↗</a></div></article>)}</div></section>
  <CaseClosing project={project}/>
</article>
<script>
  import { mountTabs } from '../../lib/tabs';
  import { ClothController } from '../cloth/controller';
  import { paperConfig } from '../cloth/config';
  document.querySelectorAll<HTMLElement>('[data-research-desk]').forEach(root => {
    const stage=root.querySelector<HTMLElement>('[data-paper-cloth]'); if(!stage)return;
    const tabs=[...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const controller=new ClothController(stage,paperConfig,index=>tabs[index]?.click());
    mountTabs(root,index=>controller.select(index));controller.init();
    document.addEventListener('astro:before-swap',()=>controller.dispose(),{once:true});
  });
</script>

<style>
.paper-installation{position:relative;min-height:400px;height:clamp(400px,38vw,550px);touch-action:pan-y pinch-zoom;}
.paper-installation canvas{position:absolute;width:100%;height:100%;inset:0;}
.paper-installation>p{position:absolute;bottom:0;inset-inline:0;text-align:center;font-size:11px;color:var(--muted);pointer-events:none;}
.research-desk .desk-sheets{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;min-height:0;margin:0;padding:35px 0;}
.research-desk .desk-sheet{transform:none!important;position:relative;min-height:260px;padding:22px 16px;box-shadow:none;background:var(--stage-color);border-radius:3px;}
.research-desk .desk-sheet strong{font-size:32px;}
.research-desk .sheet-pin-rivet,.research-desk .sheet-rule,.research-desk .sheet-mark{display:none;}
.paper-installation:is([data-cloth-state='running'],[data-cloth-state='paused']) .desk-sheets{position:absolute;inset:0;pointer-events:none;padding:0;}
.paper-installation:is([data-cloth-state='running'],[data-cloth-state='paused']) .desk-sheet{opacity:0;pointer-events:none;}
.paper-installation:is([data-cloth-state='running'],[data-cloth-state='paused']) .desk-sheet:focus-visible{opacity:1;align-self:end;min-height:0;pointer-events:auto;outline:3px solid #516fa3;outline-offset:3px;}
.paper-installation:is([data-cloth-state='running'],[data-cloth-state='paused']) .desk-sheet:focus-visible .sheet-thought{display:none;}
.paper-installation:not([data-cloth-state='running']):not([data-cloth-state='paused']) canvas{visibility:hidden;}
.paper-installation:not([data-cloth-state='running']):not([data-cloth-state='paused']){height:auto;}
@media(max-width:640px){.research-desk .desk-sheets{grid-template-columns:repeat(2,1fr)}.paper-installation{height:630px;}.research-desk .desk-sheet{min-height:230px;}}
</style>
