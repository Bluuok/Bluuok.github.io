---
import type { Project } from '../../data/projects';
import { projects } from '../../data/projects';
import { url } from '../../lib/urls';
import { features } from '../../config/features';
import './cases.css';

const hasProjectSection = features.sections.includes('projects') && projects.length > 0;

interface Props {
  project: Project;
}

const { project } = Astro.props;

// Dynamically compute next project
const currentIndex = projects.findIndex((p) => p.id === project.id);
const nextProject = projects.length > 1
  ? projects[(currentIndex + 1) % projects.length]
  : null;
---
<article class="case-page case-threadcove container">
  <!-- Top Editorial Masthead (Full Width Grid) -->
  <header class="dossier-masthead-hero">
    <div class="dossier-hero-copy">
      <p class="eyebrow">{project.category}</p>
      <h1>{project.name}</h1>
      <p class="case-summary">{project.summary}</p>
      <p class="case-desc">{project.description}</p>
      <div class="tags-row">
        {project.tags.map((tag) => <span class="tag">{tag}</span>)}
      </div>
      <div class="case-actions">
        {project.sourceUrl && (
          <a class="button button-dark" href={project.sourceUrl} target="_blank" rel="noopener noreferrer">
            查看源码 ↗
          </a>
        )}
        <a class="button button-outline" href={url(hasProjectSection ? '#projects' : '')}>
          ← {hasProjectSection ? '返回精选作品' : '返回首页'}
        </a>
      </div>
    </div>

    <!-- Archival Dossier Metadata Card -->
    <aside class="dossier-meta-card" aria-label="项目审计档案">
      <div class="dossier-meta-header">
        <span>ARCHIVE DOSSIER // TC-REF</span>
        <span class="tag">审计档案</span>
      </div>
      <dl class="dossier-meta-list">
        <div class="dossier-meta-item">
          <dt class="dossier-meta-label">Verified Commit</dt>
          <dd class="dossier-meta-value">
            <a href={`https://github.com/Bluuok/ThreadCove/commit/${project.verifiedCommit}`} target="_blank" rel="noopener noreferrer">
              {project.verifiedCommit.slice(0, 7)} ↗
            </a>
          </dd>
        </div>
        <div class="dossier-meta-item">
          <dt class="dossier-meta-label">Audit Date</dt>
          <dd class="dossier-meta-value">{project.verifiedDate}</dd>
        </div>
        <div class="dossier-meta-item">
          <dt class="dossier-meta-label">Core Protocol</dt>
          <dd class="dossier-meta-value">Unified AgentEvent</dd>
        </div>
        <div class="dossier-meta-item">
          <dt class="dossier-meta-label">Runtime Boundary</dt>
          <dd class="dossier-meta-value">LOCAL_ONLY / REMOTE</dd>
        </div>
        <div class="dossier-meta-item">
          <dt class="dossier-meta-label">Philosophy</dt>
          <dd class="dossier-meta-value">FIELDNOTES Paper Desk</dd>
        </div>
      </dl>
    </aside>
  </header>

  <!-- Full-Width Layered Paper Desk Stage (DOM + SVG, No Three.js) -->
  <section class="paper-desk-stage" aria-labelledby="desk-title">
    <div class="paper-desk-header">
      <span class="paper-desk-title" id="desk-title">FIELDNOTES RESEARCH DESK / 线索纸桌</span>
      <span class="tag">概念示意 (DOM + SVG)</span>
    </div>

    <!-- Overlapping Staggered Paper Sheets Tablist -->
    <div class="paper-sheets-wrap" role="tablist" aria-label="研究线索阶段">
      <button class="paper-sheet" role="tab" aria-selected="true" tabindex="0" id="sheet-tab-1" aria-controls="panel-sheet-1" data-index="1">
        <span class="sheet-num">01 / QUESTION</span>
        <span class="sheet-title">命题建立</span>
        <span class="sheet-tag">Session</span>
      </button>
      <button class="paper-sheet" role="tab" aria-selected="false" tabindex="-1" id="sheet-tab-2" aria-controls="panel-sheet-2" data-index="2">
        <span class="sheet-num">02 / BACKEND</span>
        <span class="sheet-title">后端适配</span>
        <span class="sheet-tag">Backend</span>
      </button>
      <button class="paper-sheet" role="tab" aria-selected="false" tabindex="-1" id="sheet-tab-3" aria-controls="panel-sheet-3" data-index="3">
        <span class="sheet-num">03 / STREAM</span>
        <span class="sheet-title">事件归一</span>
        <span class="sheet-tag">AgentEvent</span>
      </button>
      <button class="paper-sheet" role="tab" aria-selected="false" tabindex="-1" id="sheet-tab-4" aria-controls="panel-sheet-4" data-index="4">
        <span class="sheet-num">04 / WORKSPACE</span>
        <span class="sheet-title">产物沉淀</span>
        <span class="sheet-tag">Fieldnotes</span>
      </button>
    </div>

    <!-- Conceptual Mechanism Flow Diagram (Inline SVG) -->
    <div class="paper-schematic-wrap" aria-hidden="true">
      <svg viewBox="0 0 880 120" fill="none" xmlns="http://www.w3.org/2000/svg" class="paper-schematic-svg">
        <defs>
          <marker id="arrow" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
            <path d="M 0 1 L 8 5 L 0 9 z" fill="#94a3b8" />
          </marker>
        </defs>

        <!-- Node 1: Question / Session -->
        <rect x="10" y="24" width="180" height="72" rx="6" fill="#ffffff" stroke="#cbd5e1" stroke-width="1.5" />
        <rect x="18" y="32" width="6" height="6" fill="#2563eb" />
        <text x="32" y="44" font-size="10" font-family="monospace" fill="#64748b" font-weight="600">01 / SESSION</text>
        <text x="18" y="66" font-size="13" font-family="sans-serif" fill="#0f172a" font-weight="500">命题与目录分配</text>
        <text x="18" y="82" font-size="10.5" font-family="monospace" fill="#2563eb">local-directory</text>

        <!-- Arrow 1 -> 2 -->
        <path d="M 190 60 L 234 60" stroke="#94a3b8" stroke-width="1.5" stroke-dasharray="4 4" marker-end="url(#arrow)" />

        <!-- Node 2: AgentBackend -->
        <rect x="240" y="24" width="180" height="72" rx="6" fill="#ffffff" stroke="#cbd5e1" stroke-width="1.5" />
        <rect x="248" y="32" width="6" height="6" fill="#2563eb" />
        <text x="262" y="44" font-size="10" font-family="monospace" fill="#64748b" font-weight="600">02 / BACKEND</text>
        <text x="248" y="66" font-size="13" font-family="sans-serif" fill="#0f172a" font-weight="500">多模型驱动适配</text>
        <text x="248" y="82" font-size="10.5" font-family="monospace" fill="#2563eb">AgentBackend[]</text>

        <!-- Arrow 2 -> 3 -->
        <path d="M 420 60 L 464 60" stroke="#94a3b8" stroke-width="1.5" stroke-dasharray="4 4" marker-end="url(#arrow)" />

        <!-- Node 3: AgentEvent Stream -->
        <rect x="470" y="24" width="180" height="72" rx="6" fill="#ffffff" stroke="#cbd5e1" stroke-width="1.5" />
        <rect x="478" y="32" width="6" height="6" fill="#2563eb" />
        <text x="492" y="44" font-size="10" font-family="monospace" fill="#64748b" font-weight="600">03 / STREAM</text>
        <text x="478" y="66" font-size="13" font-family="sans-serif" fill="#0f172a" font-weight="500">规范化事件总线</text>
        <text x="478" y="82" font-size="10.5" font-family="monospace" fill="#2563eb">AgentEvent Stream</text>

        <!-- Arrow 3 -> 4 -->
        <path d="M 650 60 L 694 60" stroke="#94a3b8" stroke-width="1.5" stroke-dasharray="4 4" marker-end="url(#arrow)" />

        <!-- Node 4: Fieldnotes Workspace -->
        <rect x="700" y="24" width="170" height="72" rx="6" fill="#ffffff" stroke="#cbd5e1" stroke-width="1.5" />
        <rect x="708" y="32" width="6" height="6" fill="#2563eb" />
        <text x="722" y="44" font-size="10" font-family="monospace" fill="#64748b" font-weight="600">04 / FIELDNOTES</text>
        <text x="708" y="66" font-size="13" font-family="sans-serif" fill="#0f172a" font-weight="500">研究产物沉淀</text>
        <text x="708" y="82" font-size="10.5" font-family="monospace" fill="#2563eb">workspace-archive</text>
      </svg>
    </div>

    <!-- Tab Panels (Hidden by default when JS is available) -->
    <div id="panel-sheet-1" class="paper-panel" role="tabpanel" aria-labelledby="sheet-tab-1">
      <h4>01 · 命题建立：专属 Session 与独立工作目录</h4>
      <p>每个研究任务分配专属 Session 与本地隔离目录，确保研究命题与材料来源独立可溯源，避免跨任务上下文污染。</p>
    </div>
    <div id="panel-sheet-2" class="paper-panel" role="tabpanel" aria-labelledby="sheet-tab-2">
      <h4>02 · 后端适配：AgentBackend 抽象调度层</h4>
      <p>通过抽象层统一调度不同模型后端驱动，对外暴露一致接口，同时保留各后端模型的特有边界与运行能力。</p>
    </div>
    <div id="panel-sheet-3" class="paper-panel" role="tabpanel" aria-labelledby="sheet-tab-3">
      <h4>03 · 事件归一：规范化 AgentEvent 事件流</h4>
      <p>将流式输出、工具调用与中间状态归一为标准事件词汇，Web 界面与 Electron 客户端复用同一套协议与呈现逻辑。</p>
    </div>
    <div id="panel-sheet-4" class="paper-panel" role="tabpanel" aria-labelledby="sheet-tab-4">
      <h4>04 · 产物沉淀：结构化 FIELDNOTES 成果归档</h4>
      <p>研究过程生成的结论与材料直接保存于任务专属目录中，支持多角度审阅、持续整理与离线长期归档。</p>
    </div>
  </section>

  <!-- Longitudinal Dossier Mechanism Section (Vertical Timeline) -->
  {project.mechanisms && (
    <section class="dossier-section" id="mechanism">
      <p class="eyebrow">RESEARCH LIFECYCLE</p>
      <h2>一次研究的展开路径</h2>
      <div class="dossier-timeline">
        {project.mechanisms.map((m) => (
          <div class="dossier-timeline-item">
            <div class="dossier-item-header">
              <span class="dossier-step-tag">{m.step} / {m.tag}</span>
              <h3>{m.title}</h3>
            </div>
            <p>{m.desc}</p>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- Longitudinal Tradeoffs Section (Vertical Audit Records) -->
  {project.tradeoffs && (
    <section class="dossier-section" id="tradeoffs">
      <p class="eyebrow">ENGINEERING</p>
      <h2>工程取舍与边界</h2>
      <div class="dossier-audit-list">
        {project.tradeoffs.map((t, idx) => (
          <div class="dossier-audit-card">
            <div class="dossier-audit-top">
              <span class="dossier-audit-num">AUDIT / 0{idx + 1}</span>
              <a class="dossier-audit-ref" href={t.sourceUrl} target="_blank" rel="noopener noreferrer">
                依据：{t.sourceRef} ↗
              </a>
            </div>
            <h3>{t.title}</h3>
            <p class="dossier-audit-summary">{t.summary}</p>
            <p class="dossier-audit-detail">{t.detail}</p>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- Next Project Banner -->
  {nextProject && (
    <div class="next-project-banner">
      <div>
        <p class="eyebrow">NEXT PROJECT</p>
        <h3>{nextProject.name}</h3>
        <p>{nextProject.summary}</p>
      </div>
      <a class="button button-dark" href={url(`projects/${nextProject.id}/`)}>
        阅读 {nextProject.name} 案例 <span>→</span>
      </a>
    </div>
  )}
</article>

<script>
  const desk = document.querySelector<HTMLElement>('.case-threadcove .paper-desk-stage');
  if (desk) {
    desk.classList.add('has-js');
    const sheets = desk.querySelectorAll<HTMLButtonElement>('.paper-sheet');
    const panels = desk.querySelectorAll<HTMLElement>('.paper-panel');

    function selectSheet(sheet: HTMLButtonElement) {
      sheets.forEach((s) => {
        s.setAttribute('aria-selected', 'false');
        s.setAttribute('tabindex', '-1');
      });
      panels.forEach((p) => {
        p.hidden = true;
      });

      sheet.setAttribute('aria-selected', 'true');
      sheet.setAttribute('tabindex', '0');
      const targetId = sheet.getAttribute('aria-controls');
      if (targetId) {
        const targetPanel = document.getElementById(targetId);
        if (targetPanel) targetPanel.hidden = false;
      }
    }

    // Default select first sheet
    selectSheet(sheets[0]);

    sheets.forEach((sheet) => {
      sheet.addEventListener('click', () => selectSheet(sheet));

      sheet.addEventListener('keydown', (e) => {
        const list = Array.from(sheets);
        const index = list.indexOf(sheet);
        let nextIndex = index;
        if (e.key === 'ArrowRight') nextIndex = (index + 1) % list.length;
        else if (e.key === 'ArrowLeft') nextIndex = (index - 1 + list.length) % list.length;
        else if (e.key === 'Home') nextIndex = 0;
        else if (e.key === 'End') nextIndex = list.length - 1;
        else return;

        e.preventDefault();
        list[nextIndex].focus();
        selectSheet(list[nextIndex]);
      });
    });
  }
</script>
