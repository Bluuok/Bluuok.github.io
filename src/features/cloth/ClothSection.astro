---
import { generateFacetedSvgPoster } from './geometry';
---
<section class="fabric-section" id="wind" aria-labelledby="fabric-title">
  <div class="container fabric-grid">
    <div class="fabric-copy">
      <p class="eyebrow">STUDY 01 / FABRIC OF THOUGHT</p>
      <h2 id="fabric-title">看不见的风，<br />有了形状。</h2>
      <p>从一个轻微的触碰开始。<br />让想法在材料、光线与代码之间，慢慢成形。</p>
      <span class="fabric-note">悬挂织物 · 风与重力</span>
    </div>
    <div class="cloth-stage" id="cloth-stage" data-cloth-state="idle" data-pointer-hit="false">
      <canvas class="cloth-canvas" aria-hidden="true"></canvas>
      <div class="cloth-poster" aria-hidden="true">
        <svg viewBox="0 0 680 400" xmlns="http://www.w3.org/2000/svg"><g set:html={generateFacetedSvgPoster()} /></svg>
      </div>
      <div class="fabric-caption"><span aria-hidden="true">↗</span> 掠过带起风，按住拖动，松手回摆</div>
    </div>
  </div>
</section>
<style>
  .fabric-section{padding:clamp(80px,9vw,140px) 0;position:relative;isolation:isolate;scroll-margin-top:88px;}
  .fabric-section::before{content:'';position:absolute;inset:0;z-index:-1;background:radial-gradient(ellipse at 70% 50%,rgba(140,155,235,0.08),transparent 65%),radial-gradient(circle at 30% 60%,rgba(215,190,230,0.05),transparent 55%);}
  .fabric-grid{display:grid;grid-template-columns:.72fr 1.28fr;align-items:center;gap:36px;}
  .fabric-copy h2{font-size:clamp(32px,4.2vw,60px);font-weight:400;line-height:1.4;letter-spacing:-.05em;margin:24px 0;}
  .fabric-copy>p:not(.eyebrow){font-size:15px;line-height:2;color:var(--muted);}
  .fabric-note{display:block;font:11px var(--font-mono);color:var(--muted);margin-top:40px;letter-spacing:.08em;}
  .cloth-stage{position:relative;min-width:0;aspect-ratio:1.25;overflow:hidden;touch-action:pan-y pinch-zoom;}
  .cloth-canvas,.cloth-poster{position:absolute;inset:0;width:100%;height:100%;}
  .cloth-canvas{z-index:2;display:block;}
  .cloth-poster{display:grid;place-items:center;pointer-events:none;background:transparent;}
  .cloth-poster svg{width:100%;height:auto;filter:drop-shadow(0 24px 28px #252a3912);}
  .cloth-stage:is([data-cloth-state='running'],[data-cloth-state='paused']) .cloth-poster{visibility:hidden;}
  .cloth-stage:not([data-cloth-state='running']):not([data-cloth-state='paused']) .cloth-canvas{visibility:hidden;}
  .fabric-caption{position:absolute;bottom:0;left:50%;translate:-50% 0;white-space:nowrap;z-index:3;font:11px var(--font-mono);letter-spacing:.05em;color:var(--muted);}
  .fabric-caption span{display:inline-block;margin-right:12px;color:var(--violet);}
  .cloth-stage:not([data-cloth-state='running']) .fabric-caption{visibility:hidden;}
  @media(max-width:760px){.fabric-grid{grid-template-columns:1fr;gap:20px}.fabric-section{padding:70px 0;scroll-margin-top:140px}.fabric-copy h2{font-size:38px}.fabric-note{margin-top:22px}.cloth-stage{aspect-ratio:1.12;margin-top:10px}}
</style>
<script>
  import { ClothController } from './controller';
  const stage=document.getElementById('cloth-stage');
  if(stage){const controller=new ClothController(stage);controller.init();document.addEventListener('astro:before-swap',()=>controller.dispose(),{once:true});}
</script>
