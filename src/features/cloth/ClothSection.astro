---
import { generateFacetedSvgPoster } from './geometry';
const posterSvgHtml = generateFacetedSvgPoster();
---
<section class="fabric-section" aria-labelledby="fabric-title">
  <div class="container fabric-grid">
    <div class="fabric-copy">
      <p class="eyebrow">00 / ART INSTALLATION</p>
      <h2 id="fabric-title">让想法，拥有形状。</h2>
      <p>
        一块悬浮于数字空间中的冷白纤维薄布。折脊分明，自然下垂，微光流转。让想法拥有可感知的质地与张力。
      </p>
    </div>

    <!-- Right-side 55-65% container -->
    <div class="cloth-stage" id="cloth-stage" data-cloth-state="idle" data-pointer-hit="false">
      <!-- High-craft 3D WebGL Canvas -->
      <canvas class="cloth-canvas" aria-hidden="true"></canvas>

      <!-- Shaded Faceted 3D Poster: Projected from identical camera angle with directional normals -->
      <div class="cloth-poster" aria-hidden="true">
        <svg viewBox="0 0 680 400" fill="none" xmlns="http://www.w3.org/2000/svg" class="cloth-poster-svg">
          <filter id="clothFacetedShadow" x="-20%" y="-20%" width="140%" height="150%">
            <feDropShadow dx="0" dy="16" stdDeviation="22" flood-color="#191e2d" flood-opacity="0.07" />
          </filter>
          <g filter="url(#clothFacetedShadow)" set:html={posterSvgHtml} />
        </svg>
      </div>

      <span class="fabric-caption">移动指针，轻触风的形状</span>
    </div>
  </div>
</section>

<style>
  .fabric-section {
    padding-block: 110px;
    border-bottom: 1px solid var(--border-subtle);
    background: var(--bg);
  }
  .fabric-grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 48px;
    align-items: center;
  }
  .fabric-copy h2 {
    font-size: clamp(30px, 4vw, 48px);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1.3;
    margin-block: 14px 20px;
  }
  .fabric-copy p {
    color: var(--muted);
    font-size: 14.5px;
    line-height: 1.9;
    max-width: 480px;
  }
  .cloth-stage {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    background: transparent;
    border: 0;
    border-radius: 0;
    box-shadow: none;
    overflow: hidden;
  }
  .cloth-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    z-index: 2;
    touch-action: pan-y pinch-zoom;
  }
  .cloth-poster {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #ffffff;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }
  .cloth-poster-svg {
    width: 100%;
    height: 100%;
    display: block;
  }
  /* Canvas is rendered on top; hide poster only when active WebGL frame is running or paused */
  .cloth-stage[data-cloth-state="running"] .cloth-poster,
  .cloth-stage[data-cloth-state="paused"] .cloth-poster {
    opacity: 0;
    visibility: hidden;
  }
  .cloth-stage:not([data-cloth-state="running"]):not([data-cloth-state="paused"]) .cloth-canvas {
    visibility: hidden;
  }
  .cloth-stage:not([data-cloth-state="running"]) .fabric-caption {
    visibility: hidden;
  }
  .cloth-stage[data-cloth-state="idle"] .cloth-poster,
  .cloth-stage[data-cloth-state="loading"] .cloth-poster,
  .cloth-stage[data-cloth-state="static"] .cloth-poster,
  .cloth-stage[data-cloth-state="fallback"] .cloth-poster {
    opacity: 1;
    visibility: visible;
  }
  .fabric-caption {
    position: absolute;
    left: 18px;
    bottom: 14px;
    font: 10px var(--font-mono);
    color: var(--muted);
    letter-spacing: 0.08em;
    background: rgba(255, 255, 255, 0.9);
    padding: 4px 8px;
    border-radius: 4px;
    z-index: 3;
  }
  @media (max-width: 960px) {
    .fabric-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }
</style>

<script>
  import { ClothController } from './controller';

  const stage = document.getElementById('cloth-stage');
  if (stage) {
    const controller = new ClothController(stage);
    controller.init();

    // Clean disposal on Astro View Transitions
    document.addEventListener('astro:before-swap', () => {
      controller.dispose();
    }, { once: true });
  }
</script>
