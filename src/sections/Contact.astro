---
import { site } from '../data/site';
---
<section id="contact" class="section container contact-section" aria-labelledby="contact-title">
  <p class="eyebrow">03 / CONNECT</p>
  <h2 id="contact-title">保持交流，探索可能</h2>
  <p>欢迎就 AI 智能体架构、交互实验与设计系统进行交流探讨。</p>
  <div class="contact-links">
    <a class="button button-dark" href={site.github} target="_blank" rel="noopener noreferrer">
      访问 GitHub <span>↗</span>
    </a>
    {site.email && (
      <a class="button button-outline" href={`mailto:${site.email}`}>
        发送邮件 <span>↗</span>
      </a>
    )}
  </div>
</section>
