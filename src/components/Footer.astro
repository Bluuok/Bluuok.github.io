---
import { site } from '../data/site';
import { url } from '../lib/urls';
import { coreProjects } from '../data/projects';
---
<footer class="site-footer">
  <div class="container footer-inner">
    <nav class="footer-nav" aria-label="站点地图">
      <a href={url('')}>首页</a>
      {coreProjects.map((p) => (
        <a href={url(`projects/${p.id}/`)}>{p.name}</a>
      ))}
      <a href={url('playground/')}>Playground</a>
      <a href={site.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
    </nav>
    <p class="footer-copy">© {new Date().getFullYear()} {site.name} · Digital Atelier</p>
  </div>
</footer>
