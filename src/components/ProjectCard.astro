---
import type { Project } from '../data/projects';
import ProjectArt from './ProjectArt.astro';
interface Props { project: Project }
const { project } = Astro.props;
const href = `${import.meta.env.BASE_URL}projects/${project.id}/`;
---
<article class="project-card">
  <a class="project-cover" href={href} aria-label={`查看 ${project.name} 项目页`}>
    {project.image ? <img src={project.image} alt={project.imageAlt ?? project.name} loading="lazy" width="800" height="520" /> : <ProjectArt variant={project.cover} />}
    <span class="cover-arrow" aria-hidden="true">↗</span>
    {!project.image && <span class="cover-label">CONCEPT STUDY — 概念占位</span>}
  </a>
  <div class="project-info">
    <div class="project-title-row"><h3><a href={href}>{project.name}</a></h3><span class="project-index">/{project.index}</span></div>
    <p>{project.summary}</p>
    <div class="project-meta"><div>{project.tags.map(tag => <span class="tag">{tag}</span>)}</div><a class="text-link" href={href}>走近作品 <span aria-hidden="true">↗</span></a></div>
  </div>
</article>
