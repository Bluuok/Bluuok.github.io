---
import type { Project } from '../data/projects';
import ProjectArt from './ProjectArt.astro';
import { url } from '../lib/urls';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const projectHref = url(`projects/${project.id}/`);
---
<article class="project-card">
  <a class="project-cover" href={projectHref} aria-label={`查看 ${project.name} 详情`}>
    {project.image ? (
      <img src={project.image} alt={project.imageAlt ?? project.name} width="640" height="385" loading="lazy" />
    ) : (
      <>
        <ProjectArt variant={project.cover} />
        <span class="cover-label">概念图 · 点击进入</span>
      </>
    )}
    <span class="cover-arrow" aria-hidden="true">↗</span>
  </a>
  <div class="project-info">
    <div class="project-title-row">
      <h3><a href={projectHref}>{project.name}</a></h3>
      <span class="project-index">{project.index}</span>
    </div>
    <p>{project.summary}</p>
    <div class="project-meta">
      <div class="tags-row">
        {project.tags.map((tag) => <span class="tag">{tag}</span>)}
      </div>
      <a class="card-link" href={projectHref}>详细解读 →</a>
    </div>
  </div>
</article>
