---
import { site } from '../data/site';
import { features } from '../config/features';
const labels = { projects: '作品', about: '关于', contact: '联系' };
---
<a class="skip-link" href="#main">跳到正文</a>
<header class="site-header">
  <a class="wordmark" href="#top" aria-label={`${site.name} 首页`}><span class="brand-symbol" aria-hidden="true">✳</span>{site.name}<span class="wordmark-dot">.</span></a>
  <nav aria-label="主导航">
    {features.sections.map(id => <a href={`#${id}`}>{labels[id]}</a>)}
  </nav>
  <a class="header-link" href={site.github} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
</header>
