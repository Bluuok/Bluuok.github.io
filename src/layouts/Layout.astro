---
import '../styles/tokens.css';
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const { title = site.title, description = site.description } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>✳</text></svg>" />
    <script is:inline>
      // Early apply reduced motion class to avoid flash
      try {
        const key = 'bluuok-reduced-motion';
        const saved = localStorage.getItem(key);
        const query = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (saved === 'true' || query) {
          document.documentElement.classList.add('reduced-motion');
        }
      } catch {}
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
