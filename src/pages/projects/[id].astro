---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
import ProjectArt from '../../components/ProjectArt.astro';
import { projects } from '../../data/projects';
import { site } from '../../data/site';
import { features } from '../../config/features';
export function getStaticPaths() { return projects.map(project => ({ params: { id: project.id }, props: { project } })); }
const { project } = Astro.props;
const base = import.meta.env.BASE_URL;
const hasProjects = features.sections.includes('projects');
const returnHref = hasProjects ? `${base}#projects` : base;
const returnLabel = hasProjects ? '返回全部作品' : '返回首页';
---
<Layout>
  <div id="top"></div>
  <header class="site-header"><a class="wordmark" href={base}><span class="brand-symbol" aria-hidden="true">✳</span>{site.name}<span class="wordmark-dot">.</span></a><a class="text-link" href={returnHref}>{returnLabel} <span aria-hidden="true">↗</span></a></header>
  <main id="main" class="project-detail container">
    <p class="eyebrow">{project.category}</p><h1>{project.name}</h1><p class="section-note">{project.summary}</p>
    <div class="project-cover">{project.image ? <img src={project.image} alt={project.imageAlt ?? project.name} width="1280" height="640" /> : <><ProjectArt variant={project.cover}/><span class="cover-label">CONCEPT STUDY — 概念占位</span></>}</div>
    <div class="detail-copy"><h2>故事，正在整理中。</h2><p>{project.description}</p>
      <div class="contact-links">{project.sourceUrl && <a class="button button-dark" href={project.sourceUrl} target="_blank" rel="noopener noreferrer">查看源码 ↗</a>}{project.demoUrl && <a class="button button-outline" href={project.demoUrl} target="_blank" rel="noopener noreferrer">在线体验 ↗</a>}<a class="text-link" href={returnHref}>← {returnLabel}</a></div>
    </div>
  </main>
  <Footer />
</Layout>
