---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ClawtideCase from '../../features/cases/ClawtideCase.astro';
import ThreadCoveCase from '../../features/cases/ThreadCoveCase.astro';
import { coreProjects, type CoreProject } from '../../data/projects';

export function getStaticPaths() {
  return coreProjects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

interface Props {
  project: CoreProject;
}

const { project } = Astro.props;
const pageTitle = `${project.name} — Bluuok`;
---
<Layout title={pageTitle} description={project.summary}>
  <div id="top"></div>
  <Header />
  <main id="main" tabindex="-1">
    {project.caseKind === 'clawtide' ? (
      <ClawtideCase project={project} />
    ) : project.caseKind === 'threadcove' ? (
      <ThreadCoveCase project={project} />
    ) : null}
  </main>
  <Footer />
</Layout>
