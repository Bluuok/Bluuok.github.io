---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ClawtideCase from '../../features/cases/ClawtideCase.astro';
import ThreadCoveCase from '../../features/cases/ThreadCoveCase.astro';
import { projects, type Project } from '../../data/projects';
import { url } from '../../lib/urls';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const pageTitle = `${project.name} — Bluuok`;
---
<Layout title={pageTitle} description={project.summary}>
  <div id="top"></div>
  <Header />
  <main id="main" tabindex="-1">
    {project.caseKind === 'clawtide' ? (
      <ClawtideCase project={project} />
    ) : project.caseKind === 'threadcove' ? (
      <ThreadCoveCase project={project} />
    ) : (
      <div class="container section">
        <h1>{project.name}</h1>
        <p>{project.description}</p>
        <p><a href={url('#projects')}>← 返回作品列表</a></p>
      </div>
    )}
  </main>
  <Footer />
</Layout>
