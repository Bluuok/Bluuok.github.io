---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hand from '../features/intro/Hand.astro';
import { experiments } from '../data/experiments';
import { features } from '../config/features';
import { introConfig } from '../features/intro/config';
import { url } from '../lib/urls';
import '../features/particles/particles.css';
import '../features/first-spark/first-spark.css';

const layout = introConfig.desktop;
const mobile = introConfig.mobile;
const sceneStyles = [
  `--contact-x:${layout.contact.x * 100}%`,
  `--contact-y:${layout.contact.y * 100}%`,
  `--left-width:${layout.handWidth.left * 100}%`,
  `--right-width:${layout.handWidth.right * 100}%`,
  `--left-angle:${layout.rotation.left}deg`,
  `--right-angle:${layout.rotation.right}deg`,
  `--gap-x:${layout.gap.x * 100}cqw`,
  `--gap-y:${layout.gap.y * 100}cqh`,
  `--mobile-contact-x:${mobile.contact.x * 100}%`,
  `--mobile-contact-y:${mobile.contact.y * 100}%`,
  `--mobile-left-width:${mobile.handWidth.left * 100}%`,
  `--mobile-right-width:${mobile.handWidth.right * 100}%`,
  `--mobile-left-angle:${mobile.rotation.left}deg`,
  `--mobile-right-angle:${mobile.rotation.right}deg`,
  `--mobile-gap-x:${mobile.gap.x * 100}cqw`,
  `--mobile-gap-y:${mobile.gap.y * 100}cqh`,
].join(';');
---
<Layout title="小作品与实验 / Playground — Bluuok" description="Bluuok 的互动实验与视觉原型画廊。">
  <div id="top"></div>
  <Header />
  <main id="main" tabindex="-1" class="container playground-page">
    <header class="playground-masthead">
      <p class="eyebrow">LABORATORY & PLAYGROUND</p>
      <h1>小作品与实验</h1>
      <p class="masthead-desc">
        探索交互边界、微光粒子与动态介质的个人工作室画廊。
      </p>
    </header>

    {features.firstSpark && (
      <>
        <section class="playground-gallery" aria-label="实验列表">
          {experiments.map((exp) => (
            <article class="experiment-card" id={exp.id} data-spark-state="idle">
              <!-- Normal Card View -->
              <div class="experiment-card-view" data-card-view>
                <div class="experiment-poster">
                  <!-- Cold-white stylized paper-hand composition SVG poster -->
                  <svg viewBox="0 0 800 450" fill="none" xmlns="http://www.w3.org/2000/svg" class="first-spark-poster-svg" aria-hidden="true">
                    <rect width="800" height="450" fill="#fafbfc" />
                    <circle cx="400" cy="225" r="140" fill="url(#sparkAmbientGlow)" opacity="0.45" />

                    <!-- Left Stylized Paper Hand (Silhouette & Creases) -->
                    <g class="poster-hand-left" opacity="0.95">
                      <path d="M120 40 L260 110 L355 195 L372 216 C374 219, 372 224, 368 225 L340 230 L280 215 L220 235 L140 160 Z" fill="#f5f3ec" stroke="#cfcbbe" stroke-width="1.5" stroke-linejoin="round" />
                      <path d="M260 110 L340 230" stroke="#b8b4a5" stroke-width="1.2" stroke-dasharray="2 4" />
                      <path d="M220 150 L310 205" stroke="#a39f90" stroke-width="1" />
                      <path d="M290 135 L372 216" stroke="#938f80" stroke-width="1.4" />
                      <circle cx="372" cy="216" r="3" fill="#24262b" />
                    </g>

                    <!-- Right Stylized Paper Hand (Silhouette & Creases) -->
                    <g class="poster-hand-right" opacity="0.95">
                      <path d="M680 410 L540 340 L445 255 L428 234 C426 231, 428 226, 432 225 L460 220 L520 235 L580 215 L660 290 Z" fill="#f5f3ec" stroke="#cfcbbe" stroke-width="1.5" stroke-linejoin="round" />
                      <path d="M540 340 L460 220" stroke="#b8b4a5" stroke-width="1.2" stroke-dasharray="2 4" />
                      <path d="M580 300 L490 245" stroke="#a39f90" stroke-width="1" />
                      <path d="M510 315 L428 234" stroke="#938f80" stroke-width="1.4" />
                      <circle cx="428" cy="234" r="3" fill="#24262b" />
                    </g>

                    <!-- The Touch Spark Gap -->
                    <ellipse cx="400" cy="225" rx="56" ry="32" stroke="url(#touchArcGrad)" stroke-width="1" stroke-dasharray="3 6" opacity="0.75" />
                    <circle cx="400" cy="225" r="4" fill="#ffffff" stroke="#9371de" stroke-width="2" />
                    <circle cx="388" cy="220" r="1.5" fill="#537ce9" opacity="0.8" />
                    <circle cx="412" cy="230" r="1.5" fill="#cd8fba" opacity="0.8" />

                    <defs>
                      <radialGradient id="sparkAmbientGlow" cx="0" cy="0" r="1" gradientUnits="userSpaceOnUse" gradientTransform="translate(400 225) scale(160 120)">
                        <stop stop-color="#dfd9f2" stop-opacity="0.85" />
                        <stop offset="0.5" stop-color="#e8edf8" stop-opacity="0.4" />
                        <stop offset="1" stop-color="#fafbfc" stop-opacity="0" />
                      </radialGradient>
                      <linearGradient id="touchArcGrad" x1="340" y1="210" x2="460" y2="240" gradientUnits="userSpaceOnUse">
                        <stop stop-color="#537ce9" />
                        <stop offset="0.5" stop-color="#9371de" />
                        <stop offset="1" stop-color="#cd8fba" />
                      </linearGradient>
                    </defs>
                  </svg>

                  <div class="poster-overlay">
                    <span class="poster-badge">{exp.badge}</span>
                    <span class="poster-caption">概念图 / 静态构图</span>
                  </div>
                </div>

                <div class="experiment-info">
                  <div class="exp-header-row">
                    <h2>{exp.title}</h2>
                    <span class="exp-status-tag">{exp.status}</span>
                  </div>
                  <p class="exp-summary">{exp.summary}</p>
                  <p class="exp-desc">{exp.description}</p>

                  <div class="exp-actions">
                    <button class="button button-dark btn-start-first-spark" type="button" hidden>
                      开始体验 <span>↗</span>
                    </button>
                    <noscript>
                      <p class="noscript-hint">（此交互体验需要启用 JavaScript 以加载手部滚动分镜与微光粒子）</p>
                    </noscript>
                    <a class="text-link" href={url('')}>← 返回首页</a>
                  </div>
                  <p class="first-spark-error" aria-live="polite" hidden></p>
                </div>
              </div>

              <!-- Active Stage Mount Point (expanded in place upon start) -->
              <div class="first-spark-stage-mount" data-stage-mount hidden></div>
            </article>
          ))}
        </section>

        <!-- Inert DOM Template for lazy loading (rendered ONLY if features.firstSpark is true) -->
        <template id="first-spark-template">
          <div class="first-spark-active-wrapper" data-spark-wrapper>
            <!-- Floating stage controls bar (always visible, outside inert opening subtree) -->
            <div class="first-spark-controls" data-controls aria-label="First Spark 体验控制">
              <button type="button" class="button button-outline btn-spark-close" data-action="close">
                ← 结束体验
              </button>
              <button type="button" class="button button-outline btn-spark-replay" data-action="replay">
                ↺ 重播
              </button>
            </div>

            <!-- The actual Intro stage structure with exact registered Hand components -->
            <section class="intro first-spark-intro" data-intro style={sceneStyles} aria-label="创造亚当：交互体验">
              <div class="intro-stage" data-stage>
                <div class="particle-field" data-particle-host aria-hidden="true">
                  <canvas class="particle-field__canvas" aria-hidden="true"></canvas>
                </div>
                <div class="intro-grain" aria-hidden="true"></div>
                <div class="intro-copy" data-opening>
                  <p class="eyebrow"><span class="status-dot"></span>01 / FIRST SPARK</p>
                  <h2>每个创造，<br /><span class="iridescent-text">始于一次触碰。</span></h2>
                  <p class="intro-description">向下滚动，体验双手指尖逼近与微光爆发。</p>
                </div>
                <div class="scene" data-camera aria-hidden="true">
                  <div class="ambient-light" data-ambient></div>
                  <Hand side="left" />
                  <Hand side="right" />
                  <div class="contact-core" data-core></div>
                  <div class="light-ring" data-ring></div>
                </div>
                <div class="exposure" data-exposure aria-hidden="true"></div>
                <div class="arrival" data-arrival aria-hidden="true">
                  <p class="eyebrow">THE FIRST SPARK</p>
                  <p class="arrival-title">让想法，<br />成为可以体验的作品。</p>
                  <p>指尖接触瞬间，微光汇聚。</p>
                </div>
                <div class="intro-bottom">
                  <span class="chapter-label">FIRST SPARK — 滚动分镜</span>
                  <div class="scroll-cue"><span class="scroll-line" aria-hidden="true"></span><span data-scroll-label>向下滚动，让灵感相遇</span></div>
                </div>
              </div>
            </section>
          </div>
        </template>
      </>
    )}
  </main>
  <Footer />
</Layout>

<script>
  import { startFirstSpark } from '../features/first-spark/player';

  const card = document.getElementById('first-spark');
  const template = document.getElementById('first-spark-template') as HTMLTemplateElement | null;

  if (card && template) {
    const cardView = card.querySelector<HTMLElement>('[data-card-view]');
    const stageMount = card.querySelector<HTMLElement>('[data-stage-mount]');
    const startBtn = card.querySelector<HTMLButtonElement>('.btn-start-first-spark');
    const errorEl = card.querySelector<HTMLElement>('.first-spark-error');

    if (cardView && stageMount && startBtn && errorEl) {
      startBtn.hidden = false;

      const launch = () => {
        startFirstSpark({
          cardEl: card,
          cardViewEl: cardView,
          mountEl: stageMount,
          templateEl: template,
          startBtn,
          errorEl,
        });
      };

      startBtn.addEventListener('click', launch);

      if (window.location.hash === '#first-spark') {
        startBtn.focus();
      }
    }
  }
</script>
