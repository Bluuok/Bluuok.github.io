---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ParticleHero from '../features/home/ParticleHero.astro';
import PlaygroundPreview from '../features/home/PlaygroundPreview.astro';
import ClothSection from '../features/cloth/ClothSection.astro';
import Projects from '../sections/Projects.astro';
import About from '../sections/About.astro';
import Contact from '../sections/Contact.astro';
import {features} from '../config/features';
const sectionsMap={projects:Projects,about:About,contact:Contact};
const hasProjects=features.sections.includes('projects');
---
<Layout><div id="top"></div><Header/><main id="main" tabindex="-1"><ParticleHero/>{features.cloth&&<ClothSection/>}{features.sections.map(id=>{const Section=sectionsMap[id];return Section?<><Section/>{id==='projects'&&<PlaygroundPreview/>}</>:null;})}{!hasProjects&&<PlaygroundPreview/>}</main><Footer/></Layout>
